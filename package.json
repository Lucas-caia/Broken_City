{
  "name": "broken_city",
  "version": "1.0.0",
  "description": "Este projeto será um **roguelike narrativo de survival horror**, inspirado na estrutura de jogos como *Life in Adventure*, mas com universo, sistemas, identidade visual e decisões de design próprios.",
  "type": "module",
  "main": "dist-electron/main.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.brokencity.app",
    "productName": "Broken City",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lucas-caia/Broken_City.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Lucas-caia/Broken_City/issues"
  },
  "homepage": "https://github.com/Lucas-caia/Broken_City#readme",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}